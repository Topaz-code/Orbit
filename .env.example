# ─────────────────────────────────────────────────────────────────────────────
# Orbit configuration
#
# Copy this file to `.env` (in the project root) and edit anything you like.
# Every value below is OPTIONAL — Orbit boots with sensible defaults if this
# file does not exist at all. Nothing here is sent anywhere; it configures the
# server running on your own machine.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────────────────────
# The single port that serves the API, MQTT broker, PeerJS signalling and uploads.
PORT=4000
# 0.0.0.0 makes Orbit reachable from other devices on your network (phones, tablets).
# Use 127.0.0.1 to restrict it to this machine only.
HOST=0.0.0.0
NODE_ENV=development

# ── Security ─────────────────────────────────────────────────────────────────
# CHANGE THESE BEFORE EXPOSING ORBIT TO A NETWORK.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=orbit-dev-access-secret-change-me
JWT_REFRESH_SECRET=orbit-dev-refresh-secret-change-me

# How long an access token stays valid (ms/vercel style: 15m, 1h, 7d).
ACCESS_TOKEN_TTL=15m
# How long a refresh token (a "stay signed in" session) lives, in days.
REFRESH_TOKEN_TTL_DAYS=30
# bcrypt cost factor. Higher is slower and safer. 10 is the project minimum.
BCRYPT_ROUNDS=10

# ── Uploads ──────────────────────────────────────────────────────────────────
# Maximum accepted file sizes, in bytes. Defaults: 10MB images, 50MB video.
MAX_IMAGE_BYTES=10485760
MAX_VIDEO_BYTES=52428800

# ── Product rules ────────────────────────────────────────────────────────────
# Orbit deliberately keeps groups small enough to stay personal.
MAX_GROUP_MEMBERS=10
# Stories disappear after this many hours.
STORY_TTL_HOURS=24
# How often the background job deletes expired stories and their media files.
STORY_CLEANUP_INTERVAL_MINUTES=60

# ── Storage locations ────────────────────────────────────────────────────────
# Override where Orbit keeps its data. Handy for pointing at an external drive.
# ORBIT_DATA_DIR=/absolute/path/to/orbit-data
# DATABASE_FILE=/absolute/path/to/orbit.db
# UPLOADS_DIR=/absolute/path/to/uploads

# ── Networking ───────────────────────────────────────────────────────────────
# Comma-separated list of allowed browser origins. Empty = reflect any origin,
# which is fine for local use. Set this if you put Orbit behind a domain.
# CLIENT_ORIGIN=https://orbit.example.com

# Expose a raw MQTT TCP port as well as the browser WebSocket listener. Only
# needed if you want to connect a desktop/native MQTT client.
# MQTT_TCP_PORT=1883
