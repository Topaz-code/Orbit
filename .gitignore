# Dependencies
node_modules/
.pnp
.pnp.js

# Build output
dist/
build/
*.tsbuildinfo

# Generated Prisma client (recreated by `npm run db:setup`)
server/prisma/generated/

# Database — your Orbit data lives here, it should never be committed
*.db
*.db-journal
*.db-wal
*.db-shm
server/prisma/orbit.db*

# Uploaded and seeded media (regenerated by `npm run db:seed`)
server/uploads/avatars/*
server/uploads/covers/*
server/uploads/posts/*
server/uploads/stories/*
server/uploads/messages/*
server/uploads/groups/*
!server/uploads/**/.gitkeep

# Data export files produced by Settings → Data
orbit-export-*.json

# Environment / secrets
.env
.env.*
!.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editors and OS cruft
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*.swo

# Test and cache artefacts
coverage/
.cache/
.vite/
.eslintcache
